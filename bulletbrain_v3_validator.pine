// ============================================================
// BulletBrain v3.0 — Strategy Validator (Pine Script v5)
// Timeframe: 1H (primary validation)
// Purpose: Visual logic validation ONLY — not a live trading script
// OI data not available in Pine — LSO uses CVD + sweep logic only
// ============================================================

//@version=6
indicator("BulletBrain v3.0 Validator", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// ============================================================
// INPUTS — Toggle each component on/off
// ============================================================
show_regime      = input.bool(true,  "Show Regime Background",    group="Display")
show_fvg         = input.bool(true,  "Show FVG Zones",            group="Display")
show_ob          = input.bool(true,  "Show Order Blocks",         group="Display")
show_lso         = input.bool(true,  "Show LSO Sweeps",           group="Display")
show_entries     = input.bool(true,  "Show Entry Signals",        group="Display")
show_zombie      = input.bool(true,  "Show Zombie State",         group="Display")

// FVG params
fvg_body_mult    = input.float(1.2,  "FVG Body Multiplier (ATR)", group="FVG",    minval=0.5, maxval=3.0, step=0.1)
fvg_rvol_thresh  = input.float(1.8,  "FVG RVOL Threshold",        group="FVG",    minval=1.0, maxval=4.0, step=0.1)
fvg_validity     = input.int(72,     "FVG Validity (candles)",    group="FVG",    minval=10,  maxval=200)

// OB params
ob_move_mult     = input.float(1.5,  "OB Move Multiplier (ATR)",  group="OB",     minval=0.5, maxval=3.0, step=0.1)
ob_rvol_thresh   = input.float(2.0,  "OB RVOL Threshold",         group="OB",     minval=1.0, maxval=4.0, step=0.1)
ob_validity      = input.int(48,     "OB Validity (candles)",     group="OB",     minval=10,  maxval=200)

// LSO params
lso_eq_tolerance = input.float(0.003,"Equal H/L Tolerance",       group="LSO",    minval=0.001, maxval=0.01, step=0.001)
lso_lookback     = input.int(50,     "Equal H/L Lookback",        group="LSO",    minval=20,  maxval=100)
lso_bw_ratio     = input.float(0.4,  "Max Body/Wick Ratio",       group="LSO",    minval=0.1, maxval=0.8, step=0.05)

// Regime params
ema_len          = input.int(200,    "EMA Length",                group="Regime")
atr_crisis       = input.float(5.0,  "Crisis ATR% Threshold",     group="Regime", minval=2.0, maxval=10.0, step=0.5)
slope_bull       = input.float(15.0, "Bull Slope Angle (deg)",    group="Regime", minval=5.0, maxval=30.0, step=1.0)
er_zombie_thresh = input.float(0.3,  "Zombie ER Threshold",       group="Regime", minval=0.1, maxval=0.6, step=0.05)
er_period        = input.int(10,     "Efficiency Ratio Period",   group="Regime", minval=5,   maxval=20)

// RVOL params
rvol_period      = input.int(20,     "RVOL Lookback (days)",      group="RVOL",   minval=10,  maxval=50)

// ============================================================
// SECTION 1 — CORE INDICATORS
// ============================================================

atr14 = ta.atr(14)
ema200 = ta.ema(close, ema_len)

// ATR%
atr_pct = atr14 / close * 100

// Time-normalized RVOL (same hour slot, last N days)
// Approximation: compare current volume to SMA of volume over lookback
vol_sma = ta.sma(volume, rvol_period * 24)  // rough 20-day average on 1H
rvol = volume / vol_sma

// CVD approximation
buy_vol  = volume * (close - low)  / math.max(high - low, 0.0001)
sell_vol = volume * (high - close) / math.max(high - low, 0.0001)
cvd_delta = buy_vol - sell_vol
cvd = ta.cum(cvd_delta)

// ============================================================
// SECTION 2 — REGIME DETECTION
// ============================================================

// EMA slope angle (degrees) over last 10 periods
ema200_prev10 = ta.ema(close[10], ema_len)
slope_raw = (ema200 - ema200_prev10) / 10
slope_angle = math.atan(slope_raw / ema200) * (180 / math.pi)

// Price above EMA200 count (last 30 candles)
price_above_ema = 0
for i = 0 to 29
    if close[i] > ema200[i]
        price_above_ema += 1

// Efficiency Ratio for Zombie detection
er_directional = math.abs(close - close[er_period])
er_path = 0.0
for i = 1 to er_period
    er_path += math.abs(close[i-1] - close[i])
efficiency_ratio = er_path == 0 ? 0 : er_directional / er_path

// Regime classification
regime_crisis  = atr_pct > atr_crisis
regime_bull    = not regime_crisis and slope_angle >= slope_bull  and price_above_ema >= 20
regime_bear    = not regime_crisis and slope_angle <= -slope_bull and price_above_ema <= 10
regime_zombie  = not regime_crisis and not regime_bull and not regime_bear and efficiency_ratio < er_zombie_thresh
regime_ranging = not regime_crisis and not regime_bull and not regime_bear and not regime_zombie

// Regime colors
regime_color =
  regime_crisis  ? color.new(color.red,    85) :
  regime_bear    ? color.new(color.orange, 88) :
  regime_bull    ? color.new(color.green,  90) :
  regime_zombie  ? color.new(color.gray,   85) :
                   color.new(color.blue,   92)

bgcolor(show_regime ? regime_color : na)

// Regime label on last bar
if barstate.islast and show_regime
    regime_text =
      regime_crisis  ? "CRISIS" :
      regime_bear    ? "BEAR" :
      regime_bull    ? "BULL" :
      regime_zombie  ? "ZOMBIE" :
                       "RANGING"
    label.new(bar_index, high * 1.002, regime_text,
      color=color.new(color.white, 0),
      textcolor=color.black,
      style=label.style_label_down,
      size=size.small)

// Plot EMA200
plot(ema200, "EMA 200", color=color.new(color.yellow, 0), linewidth=2)

// ============================================================
// SECTION 3 — FVG DETECTOR
// ============================================================
// Bullish FVG: candle[i-1].high < candle[i+1].low
// Detected on current bar as: high[2] < low[0] (looking back)
// candle[i] = bar[1], candle[i-1] = bar[2], candle[i+1] = bar[0]

fvg_body       = math.abs(close[1] - open[1])
fvg_body_ok    = fvg_body > fvg_body_mult * atr14[1]
fvg_rvol_ok    = rvol[1] > fvg_rvol_thresh
fvg_gap_bull   = high[2] < low[0]
fvg_gap_bear   = low[2] > high[0]

// Asian session gate: disable FVG 22:00-07:00 UTC
hour_utc = hour(time, "UTC")
in_asian_session = hour_utc >= 22 or hour_utc < 7
fvg_session_ok = not in_asian_session

bullish_fvg = fvg_gap_bull and fvg_body_ok and fvg_rvol_ok and fvg_session_ok and (regime_bull or regime_ranging)
bearish_fvg = fvg_gap_bear and fvg_body_ok and fvg_rvol_ok and fvg_session_ok and (regime_bear or regime_ranging)

// Draw FVG zones
var box[] fvg_boxes = array.new_box()

if bullish_fvg and show_fvg
    fvg_top    = low[0]
    fvg_bottom = high[2]
    fvg_mid    = (fvg_top + fvg_bottom) / 2
    b = box.new(bar_index - 1, fvg_top, bar_index + fvg_validity, fvg_bottom,
      border_color=color.new(color.lime, 40),
      bgcolor=color.new(color.lime, 85))
    array.push(fvg_boxes, b)
    line.new(bar_index - 1, fvg_mid, bar_index + fvg_validity, fvg_mid,
      color=color.new(color.lime, 20), style=line.style_dashed, width=1)

if bearish_fvg and show_fvg
    fvg_top    = low[2]
    fvg_bottom = high[0]
    fvg_mid    = (fvg_top + fvg_bottom) / 2
    b = box.new(bar_index - 1, fvg_top, bar_index + fvg_validity, fvg_bottom,
      border_color=color.new(color.red, 40),
      bgcolor=color.new(color.red, 85))
    array.push(fvg_boxes, b)
    line.new(bar_index - 1, fvg_mid, bar_index + fvg_validity, fvg_mid,
      color=color.new(color.red, 20), style=line.style_dashed, width=1)

// Entry signal: price returns to FVG midpoint
// Simplified: mark when price touches a recent FVG zone
plotshape(bullish_fvg and show_entries, "Bullish FVG Signal",
  shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(bearish_fvg and show_entries, "Bearish FVG Signal",
  shape.triangledown, location.abovebar, color.red, size=size.small)

// ============================================================
// SECTION 4 — ORDER BLOCK DETECTOR
// ============================================================
// Bullish OB: last bearish candle before significant move UP
// Bearish OB: last bullish candle before significant move DOWN

ob_move_up   = close > open and math.abs(close - open) >= ob_move_mult * atr14 and rvol >= ob_rvol_thresh
ob_move_down = close < open and math.abs(close - open) >= ob_move_mult * atr14 and rvol >= ob_rvol_thresh

// Bullish OB: previous candle was bearish, current candle is a strong bull move
bullish_ob = ob_move_up and close[1] < open[1] and fvg_session_ok and (regime_bull or regime_ranging)
// Bearish OB: previous candle was bullish, current candle is a strong bear move
bearish_ob = ob_move_down and close[1] > open[1] and fvg_session_ok and (regime_bear or regime_ranging)

if bullish_ob and show_ob
    box.new(bar_index - 1, high[1], bar_index + ob_validity, low[1],
      border_color=color.new(color.aqua, 30),
      bgcolor=color.new(color.aqua, 88))
    label.new(bar_index - 1, high[1], "OB",
      color=color.new(color.aqua, 20),
      textcolor=color.white,
      style=label.style_label_down,
      size=size.tiny)

if bearish_ob and show_ob
    box.new(bar_index - 1, high[1], bar_index + ob_validity, low[1],
      border_color=color.new(color.fuchsia, 30),
      bgcolor=color.new(color.fuchsia, 88))
    label.new(bar_index - 1, low[1], "OB",
      color=color.new(color.fuchsia, 20),
      textcolor=color.white,
      style=label.style_label_up,
      size=size.tiny)

// ============================================================
// SECTION 5 — LSO DETECTOR (Equal Highs/Lows + Sweep)
// ============================================================

// Equal Lows detection (buy-side liquidity pool)
// Find if current low is within tolerance of any low in lookback
eq_low_found = false
eq_low_level = 0.0
for i = 5 to lso_lookback
    if math.abs(low - low[i]) / low < lso_eq_tolerance
        eq_low_found := true
        eq_low_level := (low + low[i]) / 2
        break

// Equal Highs detection (sell-side liquidity pool)
eq_high_found = false
eq_high_level = 0.0
for i = 5 to lso_lookback
    if math.abs(high - high[i]) / high < lso_eq_tolerance
        eq_high_found := true
        eq_high_level := (high + high[i]) / 2
        break

// Plot equal highs/lows levels
if eq_low_found and show_lso
    line.new(bar_index - lso_lookback, eq_low_level, bar_index + 10, eq_low_level,
      color=color.new(color.yellow, 30), style=line.style_dotted, width=2)

if eq_high_found and show_lso
    line.new(bar_index - lso_lookback, eq_high_level, bar_index + 10, eq_high_level,
      color=color.new(color.orange, 30), style=line.style_dotted, width=2)

// Sweep detection
// Bullish sweep: wick below equal lows, close above
candle_range  = high - low
candle_body   = math.abs(close - open)
body_wick_ratio = candle_range == 0 ? 1 : candle_body / candle_range

bullish_sweep = eq_low_found and
  low < eq_low_level and
  close > eq_low_level and
  body_wick_ratio < lso_bw_ratio and
  cvd_delta > 0 and
  (regime_bull or regime_ranging or regime_crisis)

bearish_sweep = eq_high_found and
  high > eq_high_level and
  close < eq_high_level and
  body_wick_ratio < lso_bw_ratio and
  cvd_delta < 0 and
  (regime_bear or regime_ranging or regime_crisis)

if bullish_sweep and show_lso
    label.new(bar_index, low, "LSO ↑",
      color=color.new(color.lime, 0),
      textcolor=color.black,
      style=label.style_label_up,
      size=size.normal)

if bearish_sweep and show_lso
    label.new(bar_index, high, "LSO ↓",
      color=color.new(color.red, 0),
      textcolor=color.white,
      style=label.style_label_down,
      size=size.normal)

// ============================================================
// SECTION 6 — ZOMBIE STATE VISUAL
// ============================================================
plotshape(regime_zombie and show_zombie, "Zombie State",
  shape.xcross, location.absolute, color.new(color.gray, 40),
  offset=0, size=size.tiny)

// ============================================================
// SECTION 7 — INFO TABLE
// ============================================================
var table info = table.new(position.top_right, 2, 8,
  bgcolor=color.new(color.black, 70),
  border_color=color.new(color.white, 50),
  border_width=1)

if barstate.islast
    regime_str =
      regime_crisis ? "🔴 CRISIS" :
      regime_bear   ? "🟠 BEAR"   :
      regime_bull   ? "🟢 BULL"   :
      regime_zombie ? "⚫ ZOMBIE" :
                      "🔵 RANGING"

    table.cell(info, 0, 0, "Regime",        text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, regime_str,      text_color=color.white, text_size=size.small)
    table.cell(info, 0, 1, "ATR%",          text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(math.round(atr_pct, 3)) + "%", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 2, "EMA Slope",     text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(math.round(slope_angle, 1)) + "°", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 3, "RVOL",          text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(math.round(rvol, 2)) + "×", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 4, "Eff. Ratio",    text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(math.round(efficiency_ratio, 3)), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 5, "CVD Delta",     text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(math.round(cvd_delta, 0)), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 6, "Asian Session", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, in_asian_session ? "🔒 FVG/OB OFF" : "✅ Active", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 7, "Price>EMA200",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7, str.tostring(price_above_ema) + "/30", text_color=color.white, text_size=size.small)
