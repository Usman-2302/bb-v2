# BulletBrain v3.0 — Environment Variables
# Copy this file to .env and fill in your keys
# cp .env.example .env

# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# Binance Futures API (read-only for shadow trading)
# Create at: https://testnet.binancefuture.com/ or https://www.binance.com/en/futures
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ─────────────────────────────────────────────────────────────
# OPTIONAL (Phase D14 shadow mode doesn't need these yet)
# ─────────────────────────────────────────────────────────────

# Coinglass API for OI data (future use)
# COINGLASS_API_KEY=your_coinglass_key_here

# Telegram Bot for alerts (future use)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────

# Node environment
NODE_ENV=production

# Timezone for logs (Tokyo)
TZ=Asia/Tokyo

# ─────────────────────────────────────────────────────────────
# NOTE: Shadow mode does NOT place real orders.
# API keys are used only for WebSocket authentication.
# No funds are at risk.
# ─────────────────────────────────────────────────────────────
